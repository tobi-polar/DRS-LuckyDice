<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>LuckyDice</AssemblyName>
    <RootNamespace>LuckyDice</RootNamespace>
    <Version>1.3.2</Version>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>

    <!-- Change this if your Steam library is somewhere else, or pass /p:GameDir="..." to dotnet build -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Deep Rock Galactic Survivor</GameDir>
    <InteropDir>$(GameDir)\BepInEx\interop</InteropDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile" />
  </ItemGroup>

  <!-- Every game/Unity assembly BepInEx generated in BepInEx\interop (created on first modded launch). -->
  <ItemGroup>
    <InteropDll Include="$(InteropDir)\*.dll" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="@(InteropDll)">
      <HintPath>%(InteropDll.Identity)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Drop the built DLL straight into the plugins folder. -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx\plugins')">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(GameDir)\BepInEx\plugins\LuckyDice" />
    <Copy SourceFiles="Assets\dice.mesh;Assets\dice.png" DestinationFolder="$(GameDir)\BepInEx\plugins\LuckyDice" />
  </Target>

</Project>
